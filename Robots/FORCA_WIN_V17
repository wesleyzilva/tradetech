{
  Robo  : FORCA_WIN_V17
  Tipo  : NTSL (estrategia/robo executavel)
  Ativo : WIN (mini-indice)
  Versao: 17.0
  Base  : FORCA_WIN_V14

  === ORIGEM DAS MUDANCAS: OCR das imagens ScreenToStudy_MaterOfTrades ===

  A analise anterior (V14) usou apenas o telasAnalise.md (resumo textual).
  O OCR das 27 imagens com Windows.Media.Ocr revelou 4 divergencias criticas
  entre o codigo V14 e o que estava sendo observado/anotado visualmente.

  === MUDANCAS V17 vs V14 (baseadas em OCR direto) ===

  1. StopMinimo: 822 → 150 pts                        [CRITICO — OCR]
     — Todas as imagens WIN com painel de ordens mostram "stop0f. 150" ou
       "stop0f. 155". O V14 usava 822 pts (2x range medio 15min).
     — Divergencia de ~5x entre o stop visual e o stop do robo.
     — Imagens fonte: SinalForteAteOnde, SinalForteVoltoueDeuPerda,
       SinalDiarioiniciandoEm60m, 3sinais_menores_devo_aguardar,
       ProbabilidadeSinal60min, 3sinais_menores_1maior_PERDA.
     — FatorRangeSL desligado (0.0) para manter o SL fixo em 150.

  2. ForcaMinimaForte: 70 → 65                        [CRITICO — OCR]
     — O painel do indicador FR(RSD[9]) mostra linhas horizontais em:
         90,00 (superior) / 65,00 (inferior) / 10,00 (piso)
     — V14 usava 70/85/10. O threshold real observado era 65, nao 70.
     — Impacto: mais sinais gerados (F 65-70 agora validos).

  3. ForcaExaustao: 85 → 90                           [MEDIO — OCR]
     — Mesma fonte. Linha superior do painel FR(RSD[9]) = 90,00.
     — V14 usava 85. Exaustao real era 90.
     — Impacto: zona exaustao mais estreita (90-100 em vez de 85-100).

  4. BreakEven absoluto: ratio 0.5 → 75 pts absolutos [CRITICO — OCR]
     — Captura 04/05 mostra anotacao: "50 pts - Stop 1" (WDO, stop=15pts).
     — Padrao inferido: BE ativa em ~50% do SL como valor absoluto.
     — Para WIN com SL=150: 150 * 0.5 = 75 pts → BreakEvenPts=75.
     — Antes: BE ativava em 50% do TP = 1233 pts (absurdamente longe do SL).

  5. Trailing: 0 → 280 pts (apos BE)                  [MEDIO — OCR]
     — Imagem 2sinaisFortesOndeEstaStopTecnicoOUEstrutural mostra "280,00 ts".
     — "ts" = trailing stop de 280 pts.
     — V14 havia removido o trailing intencionalmente (V12 cortava AvgWin).
     — Reintroduzido com passo FIXO de 280 pts (diferente do V12 que usava
       passo proporcional pequeno que cortava o vencedor).

  6. Saidas parciais 3x (opcional)                    [MEDIO — OCR]
     — Imagem 3sinais_QuantosPontosBusco mostra:
         Carteira | Venda I (x3 entradas separadas = 3 ordens de saida)
         Abra_26 1 Comprado 3 (posicao de 3 contratos)
         Carteira | Venda Stop 3 (stop final com 3 contratos)
     — Padrao: entrar com iQtd contratos, fechar em 3 niveis.
     — ATENCAO: ClosePosition fecha TUDO. Saida parcial exige SellAtMarket(n)
       ou BuyAtMarket(n) — verificar suporte na plataforma.
     — Implementado com flag UsarSaidasParciais. Default: false (comportamento
       seguro = fechar tudo em cada evento de saida).
     — TP1 = 1x SL (150 pts) — fecha 1/3
     — TP2 = 2x SL (300 pts) — fecha 1/3
     — Resto: trailing 280 pts ou TP hard em TakeProfit.

  === MANTIDO DO V14 ===
    - Filtro 1o candle de forca (fForca[1] < limiar)
    - MTF tripleta 60/30/15 (iJanelaDir=2, iJanelaCtx=4)
    - Hard SL intrabar via Low/High (fSLAtivo)
    - ForcaStopContra = 70 (saida rapida por forca contraria)
    - Cores padrao verde/vermelho fraco/forte (V14+)
    - Stop horario 17:45
    - Filtro de volume (VolumeMinimo=5000)

  === CALIBRACAO / STATUS ===
    NAO rebacktestado. Parametros derivados de OCR das telas de analise.
    Backtest prioritario: WIN 15min com SL=150, BE=75, Trailing=280,
    ForcaMinimaForte=65, ForcaExaustao=90 — periodo 2024-2026.
    Comparar com V14 (SL=822, BE=1233, sem trailing, F=70/85).
}

input
  // === FORCA (V17: limiares OCR) ===
  ForcaMinimaForte(65.0);       // V17: 70 → 65 (linha inferior FR(RSD[9]))
  ForcaExaustao(90.0);          // V17: 85 → 90 (linha superior FR(RSD[9]))
  PeriodoMediaVolume(20);
  UsarFiltroVolume(true);
  VolumeMinimo(5000);

  // === MULTI-TF (tripleta WIN 15min: 60/30/15) — IDENTICO V14 ===
  iJanelaDir(2);
  iJanelaCtx(4);

  // === STOP / ALVO (V17: calibrados por OCR) ===
  StopMinimo(150.0);            // V17: 822 → 150 pts (stop0f. 150-155 nas telas)
  FatorRangeSL(0.0);            // V17: 2.0 → 0.0 (SL fixo, sem expansao por range)
  TakeProfit(1500.0);           // V17: hard TP em 1500 pts (10x SL, RR 10 — ajustar no backtest)
  BreakEvenPts(75.0);           // V17: NOVO — BE em 75 pts absolutos (50% do SL)
  UsarTrailing(true);           // V17: false → true
  TrailingPasso(280.0);         // V17: NOVO — passo fixo 280 pts (OCR: "280,00 ts")

  // === SAIDAS PARCIAIS (V17: opcional — default off) ===
  UsarSaidasParciais(false);    // true = 3 niveis de saida (1/3 cada)
  TP1Pts(150.0);                // TP1 = 1x SL → fecha 1/3
  TP2Pts(300.0);                // TP2 = 2x SL → fecha 1/3

  // === GERENCIAMENTO DE RISCO ===
  CapitalReais(10000.0);
  RiscoPorcentagem(1.0);        // 1% = R$100 por trade (com SL=150: 0.5 contrato → 1 min)
  PontoValorReais(0.20);        // WIN mini = R$0.20 por ponto
  MaxContratos(5);

  // === SAIDAS ===
  StopHorario_H(17);
  StopHorario_M(45);
  UsarStopCandleContra(true);
  ForcaStopContra(70.0);        // mantido do V14
  PermitirReversao(true);
  MaxBarrasEmPosicao(0);

  // === ALERTAS ===
  MostrarAlertas(true);
  HabilitarOperacoes(true);

var
  fCorpo, fRange, fVolMedia : float;
  fMassa, fAceleracao, fForca, fForcaAbs : float;
  fMediaDir, fMediaCtx : float;
  bCtxAlta, bCtxBaixa, bDirAlta, bDirBaixa : boolean;
  r, g, b : integer;
  iBarras : integer;
  bDeveOperar, bBreakEven : boolean;
  fEntrada, fSL, fSLAtivo : float;
  fTrailingRef, fLucro : float;
  iQtd, iQtdTP1, iQtdTP2 : integer;
  bTP1Fechado, bTP2Fechado : boolean;

begin
  // ─── Calculos base ────────────────────────────────────────────
  fCorpo := Close - Open;
  fRange := High - Low;
  if fRange <= 0 then fRange := 0.0001;
  fVolMedia := Media(PeriodoMediaVolume, Volume);
  if fVolMedia <= 0 then fVolMedia := 1;

  // ─── F = M x A ────────────────────────────────────────────────
  fMassa      := fCorpo / fRange;
  fAceleracao := Volume / fVolMedia;
  fForca      := fMassa * fAceleracao * 100;
  if fForca >  100 then fForca :=  100;
  if fForca < -100 then fForca := -100;
  fForcaAbs := abs(fForca);

  // ─── Multi-TF ─────────────────────────────────────────────────
  fMediaDir := Media(iJanelaDir, Close);
  fMediaCtx := Media(iJanelaCtx, Close);
  bCtxAlta  := (Close > fMediaCtx) and (fMediaCtx > fMediaCtx[iJanelaCtx]);
  bCtxBaixa := (Close < fMediaCtx) and (fMediaCtx < fMediaCtx[iJanelaCtx]);
  bDirAlta  := (Close > fMediaDir) and (fMediaDir > fMediaDir[iJanelaDir]);
  bDirBaixa := (Close < fMediaDir) and (fMediaDir < fMediaDir[iJanelaDir]);

  // ─── Cores padrao FORCA (verde/vermelho fraco/forte) ─────────
  // Verde fraco  (F 65-90)  : forte compradora   [V17: limiar 65]
  // Verde forte  (F >= 90)  : exaustao compradora [V17: limiar 90]
  // Vermelho fraco (F -65 a -90): forte vendedora
  // Vermelho forte (F <= -90)   : exaustao vendedora
  r := 255; g := 255; b := 255;
  if fForca >= ForcaExaustao then begin r := 0;   g := 150; b := 0;   end
  else if fForca >= ForcaMinimaForte then begin r := 120; g := 220; b := 120; end
  else if fForca <= -ForcaExaustao   then begin r := 180; g := 0;   b := 0;   end
  else if fForca <= -ForcaMinimaForte then begin r := 255; g := 120; b := 120; end;
  PaintBar(RGB(r, g, b));

  // ─── SL fixo (FatorRangeSL=0 desliga expansao por range) ────
  fSL := StopMinimo;
  if (FatorRangeSL > 0) and ((fRange * FatorRangeSL) > fSL) then
    fSL := fRange * FatorRangeSL;

  // ─── Sizing por risco ─────────────────────────────────────────
  if (fSL > 0) and (PontoValorReais > 0) then
    iQtd := CapitalReais * (RiscoPorcentagem / 100) / (fSL * PontoValorReais)
  else
    iQtd := 1;
  if iQtd < 1 then iQtd := 1;
  if iQtd > MaxContratos then iQtd := MaxContratos;

  // ─── Calcula qtds para saidas parciais ────────────────────────
  if UsarSaidasParciais then
  begin
    iQtdTP1 := iQtd div 3;
    if iQtdTP1 < 1 then iQtdTP1 := 1;
    iQtdTP2 := iQtd div 3;
    if iQtdTP2 < 1 then iQtdTP2 := 1;
  end;

  // ─── Stop horario ─────────────────────────────────────────────
  if Time() >= (StopHorario_H * 10000 + StopHorario_M * 100) then
  begin
    if IsBought or IsSold then ClosePosition;
    bDeveOperar := false;
  end
  else
    bDeveOperar := true;

  // ─── Controle barras em posicao ───────────────────────────────
  if IsBought or IsSold then
    iBarras := iBarras + 1
  else begin
    iBarras      := 0;
    bBreakEven   := false;
    fTrailingRef := 0;
    bTP1Fechado  := false;
    bTP2Fechado  := false;
  end;

  if (MaxBarrasEmPosicao > 0) and (iBarras >= MaxBarrasEmPosicao) then
  begin
    if IsBought or IsSold then ClosePosition;
    iBarras := 0; bDeveOperar := false;
  end;

  // ─── Hard SL intrabar via Low/High (V14 mantido) ─────────────
  if IsBought and (Low <= fEntrada - fSLAtivo) then
  begin
    ClosePosition;
    iBarras := 0;
  end;
  if IsSold and (High >= fEntrada + fSLAtivo) then
  begin
    ClosePosition;
    iBarras := 0;
  end;

  // ─── Stop candle contra (V14 mantido: ForcaStopContra=70) ───
  if UsarStopCandleContra then
  begin
    if IsBought  and (fForca <= -ForcaStopContra) then begin ClosePosition; iBarras := 0; end;
    if IsSold    and (fForca >= ForcaStopContra)  then begin ClosePosition; iBarras := 0; end;
  end;

  // ─── [V17] Saidas parciais TP1 e TP2 ─────────────────────────
  // ATENCAO: SellAtMarket(n)/BuyAtMarket(n) fecha parcialmente.
  // Se a plataforma nao suportar, usar ClosePosition (fecha tudo).
  if UsarSaidasParciais then
  begin
    // TP1: fecha 1/3 em +TP1Pts → arma BE
    if IsBought and (not bTP1Fechado) and (High >= fEntrada + TP1Pts) then
    begin
      SellAtMarket(iQtdTP1);
      bTP1Fechado := true;
      bBreakEven  := true;
    end;
    if IsSold and (not bTP1Fechado) and (Low <= fEntrada - TP1Pts) then
    begin
      BuyAtMarket(iQtdTP1);
      bTP1Fechado := true;
      bBreakEven  := true;
    end;

    // TP2: fecha mais 1/3 em +TP2Pts → ativa trailing no restante
    if IsBought and bTP1Fechado and (not bTP2Fechado) and (High >= fEntrada + TP2Pts) then
    begin
      SellAtMarket(iQtdTP2);
      bTP2Fechado := true;
    end;
    if IsSold and bTP1Fechado and (not bTP2Fechado) and (Low <= fEntrada - TP2Pts) then
    begin
      BuyAtMarket(iQtdTP2);
      bTP2Fechado := true;
    end;
  end;

  // ─── [V17] Break-even ABSOLUTO (75 pts fixos) ────────────────
  if not bBreakEven then
  begin
    if IsBought and ((Close - fEntrada) >= BreakEvenPts) then bBreakEven := true;
    if IsSold   and ((fEntrada - Close) >= BreakEvenPts) then bBreakEven := true;
  end;
  if bBreakEven then
  begin
    if IsBought  and (Close <= fEntrada) then begin ClosePosition; iBarras := 0; end;
    if IsSold    and (Close >= fEntrada) then begin ClosePosition; iBarras := 0; end;
  end;

  // ─── [V17] Trailing fixo 280 pts (apos BE armado) ─────────────
  if UsarTrailing and bBreakEven then
  begin
    if IsBought then
    begin
      if Close - TrailingPasso > fTrailingRef then
        fTrailingRef := Close - TrailingPasso;
      if (fTrailingRef > fEntrada) and (Low <= fTrailingRef) then
        begin ClosePosition; iBarras := 0; end;
    end;
    if IsSold then
    begin
      if (fTrailingRef = 0) or (Close + TrailingPasso < fTrailingRef) then
        fTrailingRef := Close + TrailingPasso;
      if (fTrailingRef < fEntrada) and (High >= fTrailingRef) then
        begin ClosePosition; iBarras := 0; end;
    end;
  end;

  // ─── Take Profit hard ─────────────────────────────────────────
  if IsBought  and (High >= fEntrada + TakeProfit) then begin ClosePosition; iBarras := 0; end;
  if IsSold    and (Low  <= fEntrada - TakeProfit) then begin ClosePosition; iBarras := 0; end;

  // ─── ENTRADAS WIN (V14: 1o candle + MTF + volume) ─────────────
  if HabilitarOperacoes and bDeveOperar then
  begin
    // COMPRA: F >= 65 + primeiro candle + MTF + volume
    if (fForca >= ForcaMinimaForte)
      and (fForca[1] < ForcaMinimaForte)
      and bCtxAlta and bDirAlta
      and ((not UsarFiltroVolume) or (Volume >= VolumeMinimo)) then
    begin
      if PermitirReversao and IsSold then ClosePosition;
      if (not IsBought) and (not IsSold) then
      begin
        BuyAtMarket;
        fEntrada     := Close;
        fSLAtivo     := fSL;
        fTrailingRef := Close - TrailingPasso;
        iBarras      := 0;
        bBreakEven   := false;
        bTP1Fechado  := false;
        bTP2Fechado  := false;
        if MostrarAlertas then Alert(RGB(0, 200, 0));
      end;
    end;

    // VENDA: F <= -65 + primeiro candle + MTF + volume
    if (fForca <= -ForcaMinimaForte)
      and (fForca[1] > -ForcaMinimaForte)
      and bCtxBaixa and bDirBaixa
      and ((not UsarFiltroVolume) or (Volume >= VolumeMinimo)) then
    begin
      if PermitirReversao and IsBought then ClosePosition;
      if (not IsBought) and (not IsSold) then
      begin
        SellShortAtMarket;
        fEntrada     := Close;
        fSLAtivo     := fSL;
        fTrailingRef := Close + TrailingPasso;
        iBarras      := 0;
        bBreakEven   := false;
        bTP1Fechado  := false;
        bTP2Fechado  := false;
        if MostrarAlertas then Alert(RGB(200, 0, 0));
      end;
    end;
  end;

end;
