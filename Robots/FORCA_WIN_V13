{ 
  Robo  : FORCA_WIN_V13
  Tipo  : NTSL (estrategia/robo executavel)
  Ativo : WIN (mini-indice Bovespa)
  Versao: 13.0
  Base  : FORCA_WIN_V12

  === MELHORIAS V13 vs V12 ===

  1. Saida por candle branco (perda de momentum)
     — V12: saida apenas por SL/TP/BE/Trailing/CandleContra
     — V13: fecha posicao assim que a cor volta para branco (F < 70)

  2. Break-even com protecao de lucro minimo
     — V12: trigger 33% do TP, stop move para entrada (0pts protegidos)
     — V13: trigger 70% do TP (=70pts), stop em entrada + 20% do TP (=+20pts)

  3. Take Profit ajustado para 200pts (RR 2.0 com SL=100pts)
     — V12: TakeProfit=1026pts (RR 3.0)
     — V13: TakeProfit=200pts — teto; saida principal por candle branco

  4. [OPCAO 1 — RR 2.0] SL resistente a ruido + TP dobrado
     — SL=100pts, TP=200pts, RR=2.0
     — FatorRangeSL=0.59 (170pts range medio * 0.59 = 100pts)
     — Necessita win rate >= 33% para ser lucrativo
     — EV estimado: +28pts/trade (~60% win rate com candle-branco)

  === OPCAO 2 — nao implementada ===
  TP=500pts + SL=342pts (RR 1.46) NAO resolve: candle branco sai em ~50pts
  antes do TP de 500pts — average gain continua ~50pts, EV negativo.

  === CALIBRACAO (WIN 15min 2012-2026) ===
  Exaustao(F>=85): n=4735  win=44.6%  PnL=+3.058.662pts  ← MELHOR ZONA
  Ambos(F>=70):   n=6531  win=43.7%  PnL=+4.015.470pts
  WIN exaustao = melhor combinacao ativo/zona de todos os robos.
}

input
  // === FORCA ===
  ForcaMinimaForte(70.0);
  ForcaExaustao(85.0);
  PeriodoMediaVolume(20);
  UsarFiltroVolume(true);
  VolumeMinimo(2000);

  // === MULTI-TF (default 5min: tripleta 30/15/5) ===
  iJanelaDir(3);
  iJanelaCtx(6);

  // === STOP/ALVO ===
  // WIN 5min: range medio ~170pts => SL=342 (2x range)
  // WIN 15min: range medio ~411pts => SL=822 (2x range)
  StopMinimo(100.0);             // [V13 Opcao1] SL igual ao TP — RR 1.0 (resistente a ruido)
  FatorRangeSL(0.59);            // 170pts range medio * 0.59 = 100pts ~= StopMinimo
  TakeProfit(200.0);             // V13: 200pts teto — RR 2.0 (SL=100pts); saida principal = candle branco
  UsarBreakEven(true);
  BreakEvenRatio(0.70);          // V13: trigger BE com 70% do TP = 140pts
  BreakEvenProtectRatio(0.20);   // V13: stop BE = entrada + 20% do TP = +40pts
  UsarTrailing(true);
  TrailingPasso(100.0);          // trailing de 100pts atras do preco (WIN 5min)

  // === GERENCIAMENTO DE RISCO ===
  CapitalReais(10000.0);
  RiscoPorcentagem(1.0);         // 1% = R$100 por trade
  PontoValorReais(0.20);         // WIN mini: 1pt = R$0.20
  MaxContratos(10);
  MaxPerdaDiaria(1000.0);        // Stop dia = 10x SL (10 * 100pts) — proporcional ao novo SL

  // === SAIDAS ===
  StopHorario_H(17);
  StopHorario_M(45);
  UsarStopCandleContra(true);
  ForcaStopContra(85.0);
  PermitirReversao(true);
  MaxBarrasEmPosicao(0);

  // === ALERTAS ===
  MostrarAlertas(true);
  HabilitarOperacoes(true);

var
  fCorpo, fRange, fVolMedia : float;
  fMassa, fAceleracao, fForca, fForcaAbs : float;
  fMediaDir, fMediaCtx : float;
  bCtxAlta, bCtxBaixa, bDirAlta, bDirBaixa : boolean;
  r, g, b : integer;
  iBarras : integer;
  bDeveOperar, bBreakEven : boolean;
  fEntrada, fSL, fSLAtivo : float;
  fTrailingRef : float;
  iQtd : integer;
  fPerdaDia : float;
  iDiaAtual : integer;
  iZonaAnterior : integer;  // 0=neutro, 1=verde, -1=vermelho

begin
  // ─── Reset perda diaria ───────────────────────────────────────
  if Date() <> iDiaAtual then
  begin
    iDiaAtual := Date();
    fPerdaDia := 0.0;
  end;

  // ─── Calculos base ────────────────────────────────────────────
  fCorpo := Close - Open;
  fRange := High - Low;
  if fRange <= 0 then fRange := 0.0001;
  fVolMedia := Media(PeriodoMediaVolume, Volume);
  if fVolMedia <= 0 then fVolMedia := 1;

  // ─── F = M x A ────────────────────────────────────────────────
  fMassa      := fCorpo / fRange;
  fAceleracao := Volume / fVolMedia;
  fForca      := fMassa * fAceleracao * 100;
  if fForca >  100 then fForca :=  100;
  if fForca < -100 then fForca := -100;
  fForcaAbs := abs(fForca);

  // ─── Multi-TF ─────────────────────────────────────────────────
  fMediaDir := Media(iJanelaDir, Close);
  fMediaCtx := Media(iJanelaCtx, Close);
  bCtxAlta  := (Close > fMediaCtx) and (fMediaCtx > fMediaCtx[iJanelaCtx]);
  bCtxBaixa := (Close < fMediaCtx) and (fMediaCtx < fMediaCtx[iJanelaCtx]);
  bDirAlta  := (Close > fMediaDir) and (fMediaDir > fMediaDir[iJanelaDir]); // Direcao de alta
  bDirBaixa := (Close < fMediaDir) and (fMediaDir < fMediaDir[iJanelaDir]); // Direcao de baixa

  // ─── Cores — 2 tons de verde (LONG) e 2 tons de vermelho (SHORT) ─
  // Verde claro   : F >=  85 → RGB(0,255,0)     — exaustao compradora (max prioridade)
  // Verde escuro  : F >=  70 → RGB(0,140,0)     — forte compradora
  // Vermelho claro: F <= -85 → RGB(255,80,80)   — exaustao vendedora (max prioridade)
  // Vermelho escuro: F <= -70 → RGB(180,0,0)    — forte vendedora
  r := 255; g := 255; b := 255;
  if fForca >= ForcaExaustao then begin r := 0;   g := 255; b := 0;   end   // verde claro
  else if fForca >= ForcaMinimaForte then begin r := 0;   g := 140; b := 0;   end  // verde escuro
  else if fForca <= -ForcaExaustao   then begin r := 255; g := 80;  b := 80;  end  // vermelho claro
  else if fForca <= -ForcaMinimaForte then begin r := 180; g := 0;   b := 0;   end; // vermelho escuro
  PaintBar(RGB(r, g, b));

  // ─── Alerta sonoro na entrada de zona colorida ────────────────
  // iZonaAnterior: 0=neutro | 1=forte long | 2=exaustao long | -1=forte short | -2=exaustao short
  if MostrarAlertas then
  begin
    // Alarma em toda mudanca de cor (exceto branco/cinza = neutro)
    if (fForca >= ForcaExaustao) and (iZonaAnterior <> 2) then
      Alert(RGB(0, 255, 0))      // verde claro — exaustao compradora
    else if (fForca >= ForcaMinimaForte) and (iZonaAnterior <> 1) then
      Alert(RGB(0, 200, 0));     // verde escuro — forte compradora
    if (fForca <= -ForcaExaustao) and (iZonaAnterior <> -2) then
      Alert(RGB(255, 80, 80))    // vermelho claro — exaustao vendedora
    else if (fForca <= -ForcaMinimaForte) and (iZonaAnterior <> -1) then
      Alert(RGB(200, 0, 0));     // vermelho escuro — forte vendedora
  end;
  if      fForca >= ForcaExaustao      then iZonaAnterior :=  2
  else if fForca >= ForcaMinimaForte   then iZonaAnterior :=  1
  else if fForca <= -ForcaExaustao     then iZonaAnterior := -2
  else if fForca <= -ForcaMinimaForte  then iZonaAnterior := -1
  else                                      iZonaAnterior :=  0;

  // ─── SL dinamico ──────────────────────────────────────────────
  fSL := StopMinimo;
  if (fRange * FatorRangeSL) > fSL then fSL := fRange * FatorRangeSL;

  // ─── Sizing por risco ─────────────────────────────────────────
  if (fSL > 0) and (PontoValorReais > 0) then
    iQtd := CapitalReais * (RiscoPorcentagem / 100) / (fSL * PontoValorReais)
  else
    iQtd := 1;
  if iQtd < 1 then iQtd := 1;
  if iQtd > MaxContratos then iQtd := MaxContratos;

  // ─── Stop horario ─────────────────────────────────────────────
  if Time() >= (StopHorario_H * 10000 + StopHorario_M * 100) then
  begin
    if IsBought or IsSold then ClosePosition;
    bDeveOperar := false;
  end
  else
    bDeveOperar := true;

  // ─── Perda maxima diaria ─────────────────────────────────────
  if (MaxPerdaDiaria > 0) and (fPerdaDia >= MaxPerdaDiaria) then
  begin
    if IsBought or IsSold then ClosePosition;
    bDeveOperar := false;
  end;

  // ─── Controle barras em posicao ───────────────────────────────
  if IsBought or IsSold then
    iBarras := iBarras + 1
  else begin
    iBarras      := 0;
    bBreakEven   := false;
    fTrailingRef := 0;
  end;

  if (MaxBarrasEmPosicao > 0) and (iBarras >= MaxBarrasEmPosicao) then
  begin
    if IsBought or IsSold then ClosePosition;
    iBarras := 0; bDeveOperar := false;
  end;

  // ─── [V12] HARD STOP LOSS intrabar ────────────────────────────
  if IsBought and (Low <= fEntrada - fSLAtivo) then
  begin
    fPerdaDia := fPerdaDia + fSLAtivo;
    ClosePosition;
    iBarras := 0;
  end;
  if IsSold and (High >= fEntrada + fSLAtivo) then
  begin
    fPerdaDia := fPerdaDia + fSLAtivo;
    ClosePosition;
    iBarras := 0;
  end;

  // ─── Stop candle contra ───────────────────────────────────────
  if UsarStopCandleContra then
  begin
    if IsBought  and (fForca <= -ForcaStopContra) then begin ClosePosition; iBarras := 0; end;
    if IsSold    and (fForca >= ForcaStopContra)  then begin ClosePosition; iBarras := 0; end;
  end;

  // ─── [V13] Saida por candle branco (perda de momentum) ───────
  if (IsBought or IsSold) then
    if (fForca > -ForcaMinimaForte) and (fForca < ForcaMinimaForte) then
    begin
      ClosePosition;
      iBarras := 0;
    end;

  // ─── [V13] Break-even com protecao de lucro ──────────────────
  if UsarBreakEven then
  begin
    if IsBought and (not bBreakEven) then
      if (Close - fEntrada) >= (TakeProfit * BreakEvenRatio) then bBreakEven := true;
    if IsSold and (not bBreakEven) then
      if (fEntrada - Close) >= (TakeProfit * BreakEvenRatio) then bBreakEven := true;
    if bBreakEven then
    begin
      if IsBought  and (Low  <= fEntrada + (TakeProfit * BreakEvenProtectRatio)) then begin ClosePosition; iBarras := 0; end;
      if IsSold    and (High >= fEntrada - (TakeProfit * BreakEvenProtectRatio)) then begin ClosePosition; iBarras := 0; end;
    end;
  end;

  // ─── [V12] Trailing Stop apos BE ─────────────────────────────
  if UsarTrailing and bBreakEven then
  begin
    if IsBought then
    begin
      if Close - TrailingPasso > fTrailingRef then
        fTrailingRef := Close - TrailingPasso;
      if (fTrailingRef > fEntrada) and (Low <= fTrailingRef) then
        begin ClosePosition; iBarras := 0; end;
    end;
    if IsSold then
    begin
      if (Close + TrailingPasso < fTrailingRef) or (fTrailingRef = 0) then
        fTrailingRef := Close + TrailingPasso;
      if (fTrailingRef < fEntrada) and (High >= fTrailingRef) then
        begin ClosePosition; iBarras := 0; end;
    end;
  end;

  // ─── Take Profit (intrabar) ───────────────────────────────────
  if IsBought  and (High >= fEntrada + TakeProfit) then begin ClosePosition; iBarras := 0; end;
  if IsSold    and (Low  <= fEntrada - TakeProfit) then begin ClosePosition; iBarras := 0; end;

  // ─── ENTRADAS ─────────────────────────────────────────────────
  if HabilitarOperacoes and bDeveOperar then
  begin
    if (fForca >= ForcaMinimaForte)
      and bCtxAlta and bDirAlta
      and ((not UsarFiltroVolume) or (Volume >= VolumeMinimo)) then
    begin
      if PermitirReversao and IsSold then ClosePosition;
      if (not IsBought) and (not IsSold) then
      begin
        BuyAtMarket;
        fEntrada     := Close;
        fSLAtivo     := fSL;
        fTrailingRef := Close - fSL;
        iBarras      := 0;
        bBreakEven   := false;
        if MostrarAlertas then Alert(RGB(0, 200, 0));
      end;
    end;

    if (fForca <= -ForcaMinimaForte)
      and bCtxBaixa and bDirBaixa
      and ((not UsarFiltroVolume) or (Volume >= VolumeMinimo)) then
    begin
      if PermitirReversao and IsBought then ClosePosition;
      if (not IsBought) and (not IsSold) then
      begin
        SellShortAtMarket;
        fEntrada     := Close;
        fSLAtivo     := fSL;
        fTrailingRef := Close + fSL;
        iBarras      := 0;
        bBreakEven   := false;
        if MostrarAlertas then Alert(RGB(200, 0, 0));
      end;
    end;
  end;

end;
