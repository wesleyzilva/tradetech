{
  Robo  : FORCA_WIN_V15_5MIN
  Tipo  : NTSL (estrategia/robo executavel)
  Ativo : WIN (mini-indice)
  Versao: 15.0 (variante 5min)
  Base  : FORCA_WIN_V15 (mesmo perfil scalp 50-100 pts)

  === DIFERENCA vs FORCA_WIN_V15 (15min) ===

  Mesmo robo, MESMA logica de saida (TP=50, Teto=100, Trailing 15, BE 0.6).
  So muda o timeframe operacional e a tripleta MTF, para reduzir o whipsaw
  intrabar que castiga o SL=30 pts no 15min (0.07x range medio).

  Calibracao 5min:
    Range medio WIN 5min     : ~171 pts (vs 411 no 15min)
    SL=30 pts                : ~0.18x range medio (3x mais coerente que 15min)
    TP=50 pts                : ~0.29x range medio (atingivel em 1-2 candles)
    Teto=100 pts             : ~0.58x range medio (1 candle direcional cobre)
    Tripleta MTF             : 30/15/5  (iJanelaDir=3, iJanelaCtx=6)
    MaxBarrasEmPosicao       : 6 (= 30 min, equivalente aos 3 candles do 15min)

  Backtest referencia WIN 5min (V11):
    Modo AMBOS (F >= 70): n=6014  win=40.7%  PnL=+45.336 pts (TP/SL antigos)
    Nota: resultado nao se aplica ao V15 — perfil de saida totalmente diferente.

  === STATUS ===
    NAO rebacktestado. Variante experimental do V15 para 5min.
    Comparar com FORCA_WIN_V15 (15min) na mesma janela antes de operar real.
}

input
  // === FORCA ===
  ForcaMinimaForte(70.0);
  ForcaExaustao(85.0);
  PeriodoMediaVolume(20);
  UsarFiltroVolume(true);
  VolumeMinimo(5000);

  // === MULTI-TF (tripleta WIN 5min: 30/15/5) ===
  iJanelaDir(3);                // V15-5m: 5min * 3 = 15min
  iJanelaCtx(6);                // V15-5m: 5min * 6 = 30min

  // === STOP / ALVO V15 (scalp 50-100 pts) — IDENTICO V15 15min ===
  StopMinimo(30.0);
  FatorRangeSL(0.0);
  TakeProfit(50.0);
  TetoMaximo(100.0);
  UsarBreakEven(true);
  BreakEvenRatio(0.6);
  UsarTrailing(true);
  TrailingPasso(15.0);

  // === GERENCIAMENTO DE RISCO ===
  CapitalReais(10000.0);
  RiscoPorcentagem(1.0);
  PontoValorReais(0.20);
  MaxContratos(5);

  // === SAIDAS ===
  StopHorario_H(17);
  StopHorario_M(45);
  UsarStopCandleContra(true);
  ForcaStopContra(70.0);
  PermitirReversao(true);
  MaxBarrasEmPosicao(6);        // V15-5m: 6 candles = 30min (equiv. aos 3 de 15min)

  // === ALERTAS ===
  MostrarAlertas(true);
  HabilitarOperacoes(true);

var
  fCorpo, fRange, fVolMedia : float;
  fMassa, fAceleracao, fForca, fForcaAbs : float;
  fMediaDir, fMediaCtx : float;
  bCtxAlta, bCtxBaixa, bDirAlta, bDirBaixa : boolean;
  r, g, b : integer;
  iBarras : integer;
  bDeveOperar, bBreakEven : boolean;
  fEntrada, fSL, fSLAtivo : float;
  fTrailingRef : float;
  iQtd : integer;

begin
  // ─── Calculos base ────────────────────────────────────────────
  fCorpo := Close - Open;
  fRange := High - Low;
  if fRange <= 0 then fRange := 0.0001;
  fVolMedia := Media(PeriodoMediaVolume, Volume);
  if fVolMedia <= 0 then fVolMedia := 1;

  // ─── F = M x A ────────────────────────────────────────────────
  fMassa      := fCorpo / fRange;
  fAceleracao := Volume / fVolMedia;
  fForca      := fMassa * fAceleracao * 100;
  if fForca >  100 then fForca :=  100;
  if fForca < -100 then fForca := -100;
  fForcaAbs := abs(fForca);

  // ─── Multi-TF ─────────────────────────────────────────────────
  fMediaDir := Media(iJanelaDir, Close);
  fMediaCtx := Media(iJanelaCtx, Close);
  bCtxAlta  := (Close > fMediaCtx) and (fMediaCtx > fMediaCtx[iJanelaCtx]);
  bCtxBaixa := (Close < fMediaCtx) and (fMediaCtx < fMediaCtx[iJanelaCtx]);
  bDirAlta  := (Close > fMediaDir) and (fMediaDir > fMediaDir[iJanelaDir]);
  bDirBaixa := (Close < fMediaDir) and (fMediaDir < fMediaDir[iJanelaDir]);

  // ─── Cores padrao FORCA (verde/vermelho fraco e forte) ───────
  // Verde fraco  (F 70-85)  : forte compradora
  // Verde forte  (F >= 85)  : exaustao compradora
  // Vermelho fraco (F -70 a -85): forte vendedora
  // Vermelho forte (F <= -85)   : exaustao vendedora
  r := 255; g := 255; b := 255;
  if fForca >= ForcaExaustao then begin r := 0;   g := 150; b := 0;   end
  else if fForca >= ForcaMinimaForte then begin r := 120; g := 220; b := 120; end
  else if fForca <= -ForcaExaustao   then begin r := 180; g := 0;   b := 0;   end
  else if fForca <= -ForcaMinimaForte then begin r := 255; g := 120; b := 120; end;
  PaintBar(RGB(r, g, b));

  // ─── SL fixo ──────────────────────────────────────────────────
  fSL := StopMinimo;
  if (FatorRangeSL > 0) and ((fRange * FatorRangeSL) > fSL) then
    fSL := fRange * FatorRangeSL;

  // ─── Sizing por risco ─────────────────────────────────────────
  if (fSL > 0) and (PontoValorReais > 0) then
    iQtd := CapitalReais * (RiscoPorcentagem / 100) / (fSL * PontoValorReais)
  else
    iQtd := 1;
  if iQtd < 1 then iQtd := 1;
  if iQtd > MaxContratos then iQtd := MaxContratos;

  // ─── Stop horario ─────────────────────────────────────────────
  // Profit usa HHMM em Time(): 17:45 = 1745, nao 174500.
  if Time() >= (StopHorario_H * 100 + StopHorario_M) then
  begin
    if IsBought or IsSold then ClosePosition;
    bDeveOperar := false;
  end
  else
    bDeveOperar := true;

  // ─── Controle barras em posicao ───────────────────────────────
  if IsBought or IsSold then
    iBarras := iBarras + 1
  else begin
    iBarras      := 0;
    bBreakEven   := false;
    fTrailingRef := 0;
  end;

  if (MaxBarrasEmPosicao > 0) and (iBarras >= MaxBarrasEmPosicao) then
  begin
    if IsBought or IsSold then ClosePosition;
    iBarras := 0; bDeveOperar := false;
  end;

  // ─── HARD STOP LOSS via intrabar High/Low ─────────────────────
  if IsBought and (Low <= fEntrada - fSLAtivo) then
  begin
    ClosePosition;
    iBarras := 0;
  end;
  if IsSold and (High >= fEntrada + fSLAtivo) then
  begin
    ClosePosition;
    iBarras := 0;
  end;

  // ─── Stop candle contra ───────────────────────────────────────
  if UsarStopCandleContra then
  begin
    if IsBought  and (fForca <= -ForcaStopContra) then begin ClosePosition; iBarras := 0; end;
    if IsSold    and (fForca >= ForcaStopContra)  then begin ClosePosition; iBarras := 0; end;
  end;

  // ─── HARD CAP — TetoMaximo 100 pts ────────────────────────────
  if IsBought and (High >= fEntrada + TetoMaximo) then
  begin
    ClosePosition;
    iBarras := 0;
  end;
  if IsSold and (Low <= fEntrada - TetoMaximo) then
  begin
    ClosePosition;
    iBarras := 0;
  end;

  // ─── Break-even ───────────────────────────────────────────────
  if UsarBreakEven then
  begin
    if IsBought and (not bBreakEven) then
      if (Close - fEntrada) >= (TakeProfit * BreakEvenRatio) then bBreakEven := true;
    if IsSold and (not bBreakEven) then
      if (fEntrada - Close) >= (TakeProfit * BreakEvenRatio) then bBreakEven := true;
    if bBreakEven then
    begin
      if IsBought  and (Close <= fEntrada) then begin ClosePosition; iBarras := 0; end;
      if IsSold    and (Close >= fEntrada) then begin ClosePosition; iBarras := 0; end;
    end;
  end;

  // ─── Trailing curto (apos BE) ─────────────────────────────────
  if UsarTrailing and bBreakEven then
  begin
    if IsBought then
    begin
      if Close - TrailingPasso > fTrailingRef then
        fTrailingRef := Close - TrailingPasso;
      if (fTrailingRef > fEntrada) and (Low <= fTrailingRef) then
        begin ClosePosition; iBarras := 0; end;
    end;
    if IsSold then
    begin
      if (Close + TrailingPasso < fTrailingRef) or (fTrailingRef = 0) then
        fTrailingRef := Close + TrailingPasso;
      if (fTrailingRef < fEntrada) and (High >= fTrailingRef) then
        begin ClosePosition; iBarras := 0; end;
    end;
  end;

  // ─── Take Profit fixo TP1 (50 pts) ────────────────────────────
  if IsBought  and (High >= fEntrada + TakeProfit) and (not bBreakEven) then
    begin ClosePosition; iBarras := 0; end;
  if IsSold    and (Low  <= fEntrada - TakeProfit) and (not bBreakEven) then
    begin ClosePosition; iBarras := 0; end;

  // ─── ENTRADAS WIN (1o candle + MTF + volume) ──────────────────
  if HabilitarOperacoes and bDeveOperar then
  begin
    // COMPRA
    if (fForca >= ForcaMinimaForte)
      and (fForca[1] < ForcaMinimaForte)
      and bCtxAlta and bDirAlta
      and ((not UsarFiltroVolume) or (Volume >= VolumeMinimo)) then
    begin
      if PermitirReversao and IsSold then ClosePosition;
      if (not IsBought) and (not IsSold) then
      begin
        BuyAtMarket;
        fEntrada     := Close;
        fSLAtivo     := fSL;
        fTrailingRef := Close - fSL;
        iBarras      := 0;
        bBreakEven   := false;
        if MostrarAlertas then Alert(RGB(0, 200, 0));
      end;
    end;

    // VENDA
    if (fForca <= -ForcaMinimaForte)
      and (fForca[1] > -ForcaMinimaForte)
      and bCtxBaixa and bDirBaixa
      and ((not UsarFiltroVolume) or (Volume >= VolumeMinimo)) then
    begin
      if PermitirReversao and IsBought then ClosePosition;
      if (not IsBought) and (not IsSold) then
      begin
        SellShortAtMarket;
        fEntrada     := Close;
        fSLAtivo     := fSL;
        fTrailingRef := Close + fSL;
        iBarras      := 0;
        bBreakEven   := false;
        if MostrarAlertas then Alert(RGB(200, 0, 0));
      end;
    end;
  end;

end;
