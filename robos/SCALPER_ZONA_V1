{ 
  Robo  : SCALPER_ZONA_V1
  Tipo  : NTSL (estrategia/robo executavel)
  Ativo : WIN ou WDO — configurar parametros por ativo
  Versao: 1.0
  Base  : FORCA_WDO_V11 + instructions.md (detector_areas.py)

  === LOGICA DO ROBO ===

  Conceito: "Zona S/R + Confirmacao de Forca"
    Enquanto o FORCA_V11 entra em QUALQUER candle com F>=70,
    este robo so entra quando o preco esta DENTRO de uma zona
    relevante (alta/maxima recente) com forca confirmando direcao.

  Fluxo (instrucoes.md secao 9-10):
    1. Detecta zona: preco atual toca regiao high/low dos ultimos N candles
    2. Verifica forca: F >= ForcaMinima no candle atual
    3. MTF alinhado (mesmo que V11)
    4. Entra com SL pequeno (borda da zona) e TP curto (5-10 candles)

  Diferenca vs FORCA_V11:
    - V11: entra em qualquer F>=70, SL dinamico, TP longo (RR3)
    - ZONA_V1: entra APENAS se preco esta em zona consolidada,
               SL = distancia ate borda da zona (menor risco),
               TP = x_pontos da zona (atrativo mesmo com R/R ~2)
    - Prioriza QUALIDADE sobre QUANTIDADE de trades

  Parametros recomendados:
    WIN 15min: ZonaPontos=822, ForcaMinima=55, TP=822, SL=411 (R/R=2)
    WDO 15min: ZonaPontos=20,  ForcaMinima=55, TP=40,  SL=20  (R/R=2)
    WDO  5min: ZonaPontos=12,  ForcaMinima=55, TP=24,  SL=12  (R/R=2)

  Janela de zona: 3 candles para traz (instrucoes.md: "3 candles a direita")
  Tolerancia de toque: entrada quando |Close - nivel_zona| < ToleranciaZona
}

input
  // === FORCA ===
  ForcaMinima(55.0);             // limiar de entrada (instrucoes.md sec.9: F>=55)
  PeriodoMediaVolume(20);
  UsarFiltroVolume(true);
  VolumeMinimo(2000);            // ajustar: WDO=2000, WIN=5000

  // === ZONA S/R ===
  JanelaZona(3);                 // quantos candles para traz define a zona
  ZonaPontos(20.0);              // tamanho da zona em pontos (x_pontos do detector)
                                 // WDO 15min: 20 | WDO 5min: 12 | WIN 15min: 822 | WIN 5min: 342
  ToleranciaZona(5.0);           // tolerancia de toque na zona (pontos)
                                 // WDO: 5 | WIN: 200

  // === MULTI-TF ===
  iJanelaDir(2);                 // janela direcao (EMA curta)
  iJanelaCtx(4);                 // janela contexto (EMA longa)
  UsarFiltroMTF(true);           // false = ignora MTF (mais trades, menos qualidade)

  // === STOP / ALVO (calibrar por ativo) ===
  // RR=2 (mais conservador que V11-RR3) pois ja temos filtragem por zona
  StopMinimo(20.0);              // WDO 15min: 20 | WDO 5min: 12 | WIN: 411/171
  TakeProfit(40.0);              // WDO 15min: 40 | WDO 5min: 24 | WIN: 822/342
  FatorRangeSL(1.2);             // SL menor que V11 pois zona filtra melhor
  UsarBreakEven(true);
  BreakEvenRatio(0.5);

  // === GERENCIAMENTO DE RISCO ===
  CapitalReais(10000.0);
  RiscoPorcentagem(1.0);
  PontoValorReais(10.0);         // WDO=10.0 | WIN=0.20
  MaxContratos(10);

  // === SAIDAS ===
  StopHorario_H(17);
  StopHorario_M(45);
  UsarStopCandleContra(true);
  ForcaStopContra(80.0);
  PermitirReversao(false);       // false: nao reverte dentro da zona (mais conservador)
  MaxBarrasEmPosicao(8);         // sai apos 8 candles (scalp curto)

  // === ALERTAS ===
  MostrarAlertas(true);

var
  // Forca
  fCorpo, fRange, fVolMedia : float;
  fMassa, fAceleracao, fForca : float;
  fForcaAbs : float;

  // Multi-TF
  fMediaDir, fMediaCtx : float;
  bCtxAlta, bCtxBaixa, bDirAlta, bDirBaixa : boolean;

  // Zona S/R
  fMaxZona, fMinZona : float;
  fTopoZona, fBaseZona : float;           // limites superior/inferior da zona
  bZonaResistencia, bZonaSuporte : boolean;
  bToqueResistencia, bToqueSuporte : boolean;
  i : integer;

  // Controle
  fEntrada, fSL : float;
  iBarras : integer;
  bBreakEven, bDeveOperar : boolean;
  iQtd : integer;

begin
  // ─── Forca F = M x A ─────────────────────────────────────────
  fCorpo := Close - Open;
  fRange := High - Low;
  if fRange <= 0 then fRange := 0.0001;
  fVolMedia := Media(PeriodoMediaVolume, Volume);
  if fVolMedia <= 0 then fVolMedia := 1;

  fMassa      := fCorpo / fRange;
  fAceleracao := Volume / fVolMedia;
  fForca      := fMassa * fAceleracao * 100;
  if fForca >  100 then fForca :=  100;
  if fForca < -100 then fForca := -100;
  fForcaAbs := abs(fForca);

  // ─── Multi-TF ─────────────────────────────────────────────────
  fMediaDir := Media(iJanelaDir, Close);
  fMediaCtx := Media(iJanelaCtx, Close);
  bCtxAlta  := (Close > fMediaCtx) and (fMediaCtx > fMediaCtx[iJanelaCtx]);
  bCtxBaixa := (Close < fMediaCtx) and (fMediaCtx < fMediaCtx[iJanelaCtx]);
  bDirAlta  := (Close > fMediaDir) and (fMediaDir > fMediaDir[iJanelaDir]);
  bDirBaixa := (Close < fMediaDir) and (fMediaDir < fMediaDir[iJanelaDir]);

  // ─── Deteccao de Zona S/R ──────────────────────────────────────
  // Zona de resistencia: High recente (janela JanelaZona candles)
  // Zona de suporte:     Low  recente (janela JanelaZona candles)
  // Instrucoes.md sec.3: area comeca no candle atual e vai 3 candles a frente
  // Aqui invertemos: olhamos JanelaZona candles ATRAS para encontrar o nivel

  fMaxZona := High[1];         // high do candle anterior como base
  fMinZona := Low[1];          // low  do candle anterior como base

  for i := 1 to JanelaZona do
  begin
    if High[i] > fMaxZona then fMaxZona := High[i];
    if Low[i]  < fMinZona then fMinZona := Low[i];
  end;

  // Zona de resistencia: faixa [fMaxZona .. fMaxZona + ZonaPontos]
  fTopoZona           := fMaxZona + ZonaPontos;
  bZonaResistencia    := (Close >= fMaxZona - ToleranciaZona) and (Close <= fTopoZona);
  bToqueResistencia   := bZonaResistencia;

  // Zona de suporte: faixa [fMinZona - ZonaPontos .. fMinZona]
  fBaseZona           := fMinZona - ZonaPontos;
  bZonaSuporte        := (Close <= fMinZona + ToleranciaZona) and (Close >= fBaseZona);
  bToqueSuporte       := bZonaSuporte;

  // ─── PaintBar: visualizar zonas no grafico ─────────────────────
  // Branco = sem zona/sem forca
  // Verde  = toque em zona de suporte com forca compradora
  // Fucsia = toque em zona de resistencia com forca vendedora (exaustao)
  // Amarelo= toque em zona sem forca (aguardar)
  if bToqueSuporte and (fForca >= ForcaMinima) then
    PaintBar(RGB(0, 200, 0))
  else if bToqueResistencia and (fForca <= -ForcaMinima) then
    PaintBar(RGB(255, 0, 180))
  else if bToqueSuporte or bToqueResistencia then
    PaintBar(RGB(255, 220, 0))   // zona ativa mas sem confirmacao de forca
  else
    PaintBar(RGB(200, 200, 200)); // cinza: fora de zona

  // ─── Sizing por risco ─────────────────────────────────────────
  fSL := StopMinimo;
  if (fRange * FatorRangeSL) > fSL then fSL := fRange * FatorRangeSL;

  if (fSL > 0) and (PontoValorReais > 0) then
    iQtd := Trunc(CapitalReais * (RiscoPorcentagem / 100) / (fSL * PontoValorReais))
  else
    iQtd := 1;
  if iQtd < 1 then iQtd := 1;
  if iQtd > MaxContratos then iQtd := MaxContratos;

  // ─── Stop horario ─────────────────────────────────────────────
  if Time() >= (StopHorario_H * 10000 + StopHorario_M * 100) then
  begin
    if IsBought or IsSold then ClosePosition;
    bDeveOperar := false;
  end
  else
    bDeveOperar := true;

  // ─── Controle barras em posicao ───────────────────────────────
  if IsBought or IsSold then
    iBarras := iBarras + 1
  else begin
    iBarras := 0;
    bBreakEven := false;
  end;

  if (MaxBarrasEmPosicao > 0) and (iBarras >= MaxBarrasEmPosicao) then
  begin
    if IsBought or IsSold then ClosePosition;
    iBarras := 0; bDeveOperar := false;
  end;

  // ─── Stop candle contra ───────────────────────────────────────
  if UsarStopCandleContra then
  begin
    if IsBought  and (fForca <= -ForcaStopContra) then begin ClosePosition; iBarras := 0; end;
    if IsSold    and (fForca >= ForcaStopContra)  then begin ClosePosition; iBarras := 0; end;
  end;

  // ─── Break-even ───────────────────────────────────────────────
  if UsarBreakEven then
  begin
    if IsBought and (not bBreakEven) then
      if (Close - fEntrada) >= (TakeProfit * BreakEvenRatio) then bBreakEven := true;
    if IsSold and (not bBreakEven) then
      if (fEntrada - Close) >= (TakeProfit * BreakEvenRatio) then bBreakEven := true;
    if bBreakEven then
    begin
      if IsBought  and (Close <= fEntrada) then begin ClosePosition; iBarras := 0; end;
      if IsSold    and (Close >= fEntrada) then begin ClosePosition; iBarras := 0; end;
    end;
  end;

  // ─── Stop / Alvo fixos ────────────────────────────────────────
  if IsBought then
  begin
    if Close <= (fEntrada - fSL) then begin ClosePosition; iBarras := 0; end;
    if Close >= (fEntrada + TakeProfit) then begin ClosePosition; iBarras := 0; end;
  end;
  if IsSold then
  begin
    if Close >= (fEntrada + fSL) then begin ClosePosition; iBarras := 0; end;
    if Close <= (fEntrada - TakeProfit) then begin ClosePosition; iBarras := 0; end;
  end;

  // ─── ENTRADAS ─────────────────────────────────────────────────
  // Criterios COMBINADOS (instrucoes.md sec.9-10):
  //   1. Preco toca zona S/R    (zona de alta probabilidade)
  //   2. Forca confirma direcao (F >= ForcaMinima)
  //   3. MTF alinhado           (contexto favoravel)
  //   4. Volume acima do minimo

  if bDeveOperar and (not IsBought) and (not IsSold) then
  begin
    // COMPRA: suporte + forca compradora + MTF alta
    if bToqueSuporte
      and (fForca >= ForcaMinima)
      and ((not UsarFiltroMTF) or (bCtxAlta and bDirAlta))
      and ((not UsarFiltroVolume) or (Volume >= VolumeMinimo)) then
    begin
      BuyAtMarket;
      fEntrada := Close;
      iBarras  := 0; bBreakEven := false;
      if MostrarAlertas then Alert(RGB(0, 200, 0));
    end;

    // VENDA: resistencia + forca vendedora + MTF baixa
    if bToqueResistencia
      and (fForca <= -ForcaMinima)
      and ((not UsarFiltroMTF) or (bCtxBaixa and bDirBaixa))
      and ((not UsarFiltroVolume) or (Volume >= VolumeMinimo)) then
    begin
      SellShortAtMarket;
      fEntrada := Close;
      iBarras  := 0; bBreakEven := false;
      if MostrarAlertas then Alert(RGB(200, 0, 0));
    end;
  end;

  // ─── Reversao controlada ─────────────────────────────────────
  if PermitirReversao then
  begin
    if IsBought and bToqueResistencia and (fForca <= -ForcaMinima) then
    begin
      ClosePosition;
      SellShortAtMarket;
      fEntrada := Close;
      iBarras := 0; bBreakEven := false;
    end;
    if IsSold and bToqueSuporte and (fForca >= ForcaMinima) then
    begin
      ClosePosition;
      BuyAtMarket;
      fEntrada := Close;
      iBarras := 0; bBreakEven := false;
    end;
  end;

end;
